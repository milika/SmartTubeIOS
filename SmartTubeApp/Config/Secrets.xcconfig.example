// Optional local overrides. Copy this file to Config/Secrets.xcconfig.
// Never commit Secrets.xcconfig; it is gitignored.
// Find your Team ID at: https://developer.apple.com/account/#/membership
//
// Leave everything commented out to build with the upstream identity from
// Base.xcconfig. Uncomment and edit these two INPUTS only — bundle IDs, the App Group,
// the ubiquity KV store and the tvOS team are all derived from them.
//
// Changing the bundle prefix changes the app's identity (new App Group container, new
// App Store Connect record), so use your own org prefix for a fork, and regenerate
// GoogleService-Info.plist for the resulting bundle ID.

// SMARTTUBE_TEAM_ID = YOUR_TEAM_ID
// SMARTTUBE_BUNDLE_PREFIX = com.yourdomain

// Rarely needed: the manual tvOS distribution profile name in your team.
// SMARTTUBE_TV_PROVISIONING_PROFILE = Smart Tube TV
