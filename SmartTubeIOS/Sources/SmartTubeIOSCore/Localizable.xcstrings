    "Download a video from the player to watch it offline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتنزيل مقطع فيديو من المشغل لمشاهدته في وضع عدم الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie ein Video vom Player herunter, um es offline anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga un vídeo del reproductor para verlo sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez une vidéo depuis le lecteur pour la regarder hors ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी वीडियो को ऑफ़लाइन देखने के लिए उसे प्लेयर से डाउनलोड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzmite videozapis s playera kako biste ga gledali izvan mreže."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh video dari pemutar untuk menontonnya secara offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica un video dal lettore per guardarlo offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーからビデオをダウンロードしてオフラインで視聴します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어에서 비디오를 다운로드하여 오프라인으로 시청하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
