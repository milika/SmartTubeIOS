    "Opens a Home page section such as Subscriptions or Watch Later." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开首页分区，例如订阅或稍后观看。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح قسمًا من الصفحة الرئيسية مثل الاشتراكات أو \"المشاهدة لاحقًا\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet einen Startseitenbereich wie Abonnements oder „Später ansehen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre una sección de la página de inicio, como Suscripciones o Ver más tarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre una sezione della pagina Home, ad esempio Iscrizioni o Guarda più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「登録チャンネル」や「後で見る」など、ホームページのセクションを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독 또는 나중에 볼 동영상 같은 홈 페이지 섹션을 엽니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre une section de la page d’accueil, comme Abonnements ou Regarder plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम पेज का कोई अनुभाग खोलता है, जैसे सदस्यताएं या बाद में देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvara odjeljak početne stranice, primjerice Pretplate ili Gledajte kasnije."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka bagian Beranda seperti Langganan atau Tonton Nanti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre uma seção da página Início, como Inscrições ou Assistir mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает раздел главной страницы, например «Подписки» или «Смотреть позже»."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвара одељак почетне странице, као што су Претплате или Гледајте касније."
